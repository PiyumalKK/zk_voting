  <diagram id="tx-flow" name="MetaMask Transaction Flow">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0" background="#F7F9FC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="band" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1F2A44;strokeColor=none;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="64" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="ZK Voting — Transaction Lifecycle" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="80" y="26" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Registration = MetaMask-signed tx (identity-linked)   ·   Vote = local Burner-signed tx (anonymous, never touches MetaMask)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#9FB3D1;" vertex="1" parent="1">
          <mxGeometry x="80" y="56" width="1200" height="22" as="geometry" />
        </mxCell>
        <mxCell id="hUser" value="👤 Voter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F4B7C;fontColor=#FFFFFF;strokeColor=#1F2A44;shadow=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="190" height="42" as="geometry" /></mxCell>
        <mxCell id="hApp" value="🖥 dApp (Wagmi/Viem)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6C8EBF;fontColor=#FFFFFF;strokeColor=#2F4B7C;shadow=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="395" y="100" width="200" height="42" as="geometry" /></mxCell>
        <mxCell id="hMM" value="🦊 MetaMask (EIP-1193)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D79B00;fontColor=#FFFFFF;strokeColor=#9A6E00;shadow=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="100" width="210" height="42" as="geometry" /></mxCell>
        <mxCell id="hBurn" value="🔥 Burner Wallet (local key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B85450;fontColor=#FFFFFF;strokeColor=#7A2E2A;shadow=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1075" y="100" width="220" height="42" as="geometry" /></mxCell>
        <mxCell id="hRPC" value="⛓ Hardhat RPC :8545" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3C6E2A;fontColor=#FFFFFF;strokeColor=#234017;shadow=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="100" width="190" height="42" as="geometry" /></mxCell>
        <mxCell id="hSol" value="📜 Voting.sol + Verifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82B366;fontColor=#FFFFFF;strokeColor=#3C6E2A;shadow=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1580" y="100" width="80" height="42" as="geometry" /></mxCell>
        <mxCell id="lUser" style="endArrow=none;html=1;strokeColor=#2F4B7C;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="142" as="sourcePoint"/><mxPoint x="175" y="1320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lApp" style="endArrow=none;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="142" as="sourcePoint"/><mxPoint x="495" y="1320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lMM" style="endArrow=none;html=1;strokeColor=#D79B00;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="835" y="142" as="sourcePoint"/><mxPoint x="835" y="1320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lBurn" style="endArrow=none;html=1;strokeColor=#B85450;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="142" as="sourcePoint"/><mxPoint x="1185" y="1320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lRPC" style="endArrow=none;html=1;strokeColor=#3C6E2A;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1475" y="142" as="sourcePoint"/><mxPoint x="1475" y="1320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lSol" style="endArrow=none;html=1;strokeColor=#82B366;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1620" y="142" as="sourcePoint"/><mxPoint x="1620" y="1320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ph1" value="PHASE 1 — REGISTRATION  ·  signed by MetaMask, identity-linked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6EC;strokeColor=#D79B00;fontStyle=1;fontColor=#9A6E00;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1620" height="30" as="geometry" /></mxCell>
        <mxCell id="m1" value="1. connect wallet → eth_requestAccounts" style="html=1;endArrow=block;strokeColor=#2F4B7C;fontColor=#2F4B7C;strokeWidth=2;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="250" as="sourcePoint"/><mxPoint x="835" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2. generate commitment = H(nullifier, secret) — local" style="html=1;endArrow=block;strokeColor=#6C8EBF;fontColor=#2F4B7C;strokeWidth=2;rounded=1;labelBackgroundColor=#F7F9FC;align=left;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="310" as="sourcePoint"/><mxPoint x="640" y="350" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="3. register(commitment) → eth_sendTransaction (calldata)" style="html=1;endArrow=block;strokeColor=#6C8EBF;fontColor=#2F4B7C;strokeWidth=2;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="410" as="sourcePoint"/><mxPoint x="835" y="410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="4. popup: review gas, sign with private key" style="html=1;endArrow=block;strokeColor=#D79B00;fontColor=#9A6E00;strokeWidth=2;dashed=1;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="835" y="480" as="sourcePoint"/><mxPoint x="175" y="480" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="5. broadcast signed raw tx" style="html=1;endArrow=block;strokeColor=#D79B00;fontColor=#9A6E00;strokeWidth=2;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="835" y="550" as="sourcePoint"/><mxPoint x="1475" y="550" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="6. register() → push leaf, emit LeafInserted" style="html=1;endArrow=block;strokeColor=#3C6E2A;fontColor=#234017;strokeWidth=2;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1475" y="610" as="sourcePoint"/><mxPoint x="1620" y="610" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m7" value="7. tx hash + mined receipt" style="html=1;endArrow=block;strokeColor=#3C6E2A;fontColor=#234017;strokeWidth=2;dashed=1;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1475" y="670" as="sourcePoint"/><mxPoint x="495" y="670" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ph2" value="PHASE 2 — VOTE  ·  signed by local Burner key, MetaMask NOT used → unlinkable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE6E5;strokeColor=#B85450;fontStyle=1;fontColor=#B85450;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1620" height="30" as="geometry" /></mxCell>
        <mxCell id="m8" value="8. generatePrivateKey() — fresh burner (no MetaMask)" style="html=1;endArrow=block;strokeColor=#6C8EBF;fontColor=#2F4B7C;strokeWidth=2;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="810" as="sourcePoint"/><mxPoint x="1185" y="810" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="9. setBalance() fund burner for gas (local only)" style="html=1;endArrow=block;strokeColor=#3C6E2A;fontColor=#234017;strokeWidth=2;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="870" as="sourcePoint"/><mxPoint x="1475" y="870" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="10. vote(proof, nullifierHash, root, vote, depth) — burner signs" style="html=1;endArrow=block;strokeColor=#B85450;fontColor=#B85450;strokeWidth=2;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="930" as="sourcePoint"/><mxPoint x="1475" y="930" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="11. eth_sendRawTransaction" style="html=1;endArrow=block;strokeColor=#3C6E2A;fontColor=#234017;strokeWidth=2;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1475" y="990" as="sourcePoint"/><mxPoint x="1620" y="990" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="12. require root==tree.root · verify proof · nullifier unused → tally++ · emit VoteCast" style="html=1;endArrow=block;strokeColor=#82B366;fontColor=#3C6E2A;strokeWidth=2;rounded=1;labelBackgroundColor=#F7F9FC;align=center;exitX=1;exitY=0.4;entryX=1;entryY=0.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1620" y="1040" as="sourcePoint"/><mxPoint x="1620" y="1090" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="13. waitForTransactionReceipt → tx hash" style="html=1;endArrow=block;strokeColor=#3C6E2A;fontColor=#234017;strokeWidth=2;dashed=1;labelBackgroundColor=#F7F9FC;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1475" y="1150" as="sourcePoint"/><mxPoint x="495" y="1150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note" value="Why two wallets?  The MetaMask register tx links your identity to a commitment. The vote is sent from a throwaway key with zero history, so on-chain observers cannot link voter → vote. Only the ZK proof — not your address — authorizes the ballot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3D1;align=left;spacingLeft=12;spacingTop=8;fontColor=#1F2A44;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="1620" height="70" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
