NEXT_PUBLIC_CHAIN_BACKEND=custom
NEXT_PUBLIC_CHAIN_ID=9494

# Browser + mobile read the chain through the ALB (public, round-robins nodes)
NEXT_PUBLIC_RPC_URL=http://{{ alb_dns }}/chain-api

# Server-only: API routes (relay writes) hit the PRIMARY node directly
RPC_URL=http://{{ node1_ip }}:3001

SESSION_SECRET={{ session_secret }}
# ALB is plain HTTP — allow the session cookie without Secure so login sticks
SESSION_COOKIE_INSECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH={{ admin_password_hash }}
ADMIN_RELAY_PRIVATE_KEY={{ admin_relay_private_key }}
GN_KEY_ENCRYPTION_KEY={{ gn_key_encryption_key }}
SERVER_PEPPER={{ server_pepper }}

# GN officer accounts (credentials + encrypted signing keys) and the relay audit
# log live OUTSIDE the checkout so they survive deploys — the checkout at
# /opt/zk-voting is wiped on every run.
GN_ACCOUNTS_FILE=/opt/zk-voting-state/gn-accounts.json
RELAY_AUDIT_LOG=/opt/zk-voting-state/relay-audit.log
