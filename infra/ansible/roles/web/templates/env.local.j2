NEXT_PUBLIC_CHAIN_BACKEND=custom
NEXT_PUBLIC_CHAIN_ID=9494

# Browser reads the chain over HTTPS via CloudFront. The site is served over
# HTTPS, so its chain calls MUST be HTTPS too — a plain-HTTP call would be
# blocked as mixed content. CloudFront terminates TLS and forwards to the ALB,
# which round-robins the healthy validators.
NEXT_PUBLIC_RPC_URL=https://{{ cloudfront_domain | default(alb_dns) }}/chain-api

# Server-only: API routes talk to the ALB directly over the AWS network — no
# browser, no mixed-content, and one hop fewer than going back out through
# CloudFront. The ALB only routes to healthy validators; in BFT any validator
# accepts reads and forwards writes into consensus, so this keeps the app
# working if any single node (incl. node1) is stopped — no single point of
# failure.
RPC_URL=http://{{ alb_dns }}/chain-api

SESSION_SECRET={{ session_secret }}
# Public entry is HTTPS (CloudFront) but the Next.js server itself sits behind
# the ALB on plain HTTP, so keep the session cookie non-Secure or logins set
# behind the proxy won't stick.
SESSION_COOKIE_INSECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH={{ admin_password_hash }}
ADMIN_RELAY_PRIVATE_KEY={{ admin_relay_private_key }}
GN_KEY_ENCRYPTION_KEY={{ gn_key_encryption_key }}
SERVER_PEPPER={{ server_pepper }}

# GN officer accounts (credentials + encrypted signing keys) and the relay audit
# log live OUTSIDE the checkout so they survive deploys — the checkout at
# /opt/zk-voting is wiped on every run.
GN_ACCOUNTS_FILE=/opt/zk-voting-state/gn-accounts.json
RELAY_AUDIT_LOG=/opt/zk-voting-state/relay-audit.log
