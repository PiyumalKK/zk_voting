# ─── ZK Voting Blockchain Node ────────────────────────────────────────────────
# Each node in the network needs its own copy with a unique NODE_ID.

# ─── Node Identity ────────────────────────────────────────────────────────────
# The port this node listens on. Also used as the data directory name:
#   data_3001/  (blockchain DB, TLS certs, admin key)
# Change to 3002 / 3003 for additional nodes.
NODE_ID=3001

# ─── Peer Nodes ───────────────────────────────────────────────────────────────
# Comma-separated list of OTHER nodes in the network (do NOT include yourself).
# On startup the node fetches their chains and adopts the longest valid one.
# Leave empty to run a standalone single-node setup.
#
# Single node (no peers):
PEERS=
#
# Multi-node example (comment or remove the line above and uncomment following):
# PEERS=https://localhost:3002,https://localhost:3003
# PEERS=https://pc2-ip:3002,https://pc1-ip:3001

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3000
