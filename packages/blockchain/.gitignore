# Runtime data — per-node chain state (DATA_DIR; also covers legacy
# data_<NODE_ID>/ layouts from v1).
data/
data_*/

# The 3-node cluster's per-node data directories (M10; make run-cluster).
data-cluster/

# The 4-validator BFT cluster's per-node data directories
# (CONSENSUS_MODE=bft; make run-bft / make bft-cluster-test). A separate root
# from data-cluster/ so a BFT run and a solo run can coexist on one machine
# without either inheriting the other's chain.
data-cluster-bft/

# Go's temporary build tree, used via GOTMPDIR on machines whose policy
# blocks executing test binaries out of %TEMP%.
.gotmp/

# The full-election gate's own chain (M14; make e2e). Separate from data/ so
# the gate can reset it without destroying the chain M08/M09 built.
data-e2e/

# mTLS material for P2P (MASTER §7 TLS_CERT/TLS_KEY/TLS_CA; make gen-certs
# in M10). NEVER commit these — private keys live here.
certs/

# Go binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binary
*.test

# Go workspace
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
