# zk-blockchain node configuration.
#
# Configuration is environment-only — no flags, no config files. cmd/node
# loads a `.env` beside this file if one exists (godotenv), so copying this to
# `.env` and editing it is the usual local workflow. In production every value
# below comes from the systemd unit
# (infra/ansible/roles/blockchain/templates/zk-node.service.j2).
#
# Every variable is optional; the value shown is the default, taken from
# internal/config/config.go. The authoritative table is 00-MASTER.md §7.

# --- chain identity -----------------------------------------------------

# Must be identical on every node in a cluster: it feeds genesis, so a
# mismatch changes the genesis hash and peers refuse each other's block 1 on
# parentHash rather than drifting silently.
CHAIN_ID=9494

# Must also be identical across a cluster, and for the same reason.
# The mobile app submits vote() with a fixed 15,000,000 gas limit, so this has
# to stay strictly above that.
BLOCK_GAS_LIMIT=60000000

# --- ports and storage --------------------------------------------------

# JSON-RPC + /health. In production this is 3001, behind nginx (/chain-api).
RPC_PORT=9545

# mTLS peer port: block replication, and BFT consensus messages. 4001 in
# production.
P2P_PORT=9546

# Chain state. Never share one directory between two nodes — Pebble takes an
# exclusive lock and the second node will refuse to start.
DATA_DIR=./data

# --- replication (CONSENSUS_MODE=solo) ----------------------------------

# primary | replica.
#   primary with no PEERS   standalone: no certificates read, no P2P port
#                           opened. This is what `make run` does.
#   primary with PEERS      the sequencer, announcing sealed blocks.
#   replica                 follows the primary, forwards writes to it.
#
# Under CONSENSUS_MODE=bft this must be `primary` on every node: all four
# validators are co-equal writers, and a replica cannot vote.
ROLE=primary

# Primary only. Comma-separated P2P URLs of the replicas to announce blocks to.
# Empty means standalone.
PEERS=

# Replica only, both required.
PRIMARY_RPC_URL=
REPLICA_PULL_URL=

# --- BFT consensus (CONSENSUS_MODE=bft) ---------------------------------
#
# See packages/blockchain/CONSENSUS.md for the protocol, the safety argument,
# and the kill-node demonstrations.
#
# In solo mode every variable in this section must be EMPTY. A node that
# carries validator configuration while sealing on its own authority is
# refused at startup rather than ignored: it would seal blocks alone while
# three peers believed they were voting on them, which is a silent regression
# from Byzantine fault tolerance to a single trusted party.

# solo (default) | bft
CONSENSUS_MODE=solo

# This node's name within VALIDATOR_SET.
VALIDATOR_ID=

# This node's consensus signing key, hex, 0x prefix optional. Prefer the FILE
# form in production: an environment variable is visible in `ps -e` output and
# in `systemctl show`.
VALIDATOR_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY_FILE=

# The full validator registry, `name:address` per member.
#
# ORDER MATTERS and must be identical on every node: the proposer for a height
# is validators[(height + round) % N], so two nodes given the same members in
# a different order would disagree about whose turn it is at every height and
# the cluster would never make progress.
#
# The node checks at startup that VALIDATOR_PRIVATE_KEY derives to the address
# listed here for VALIDATOR_ID, because a validator signing with an unlisted
# identity is invisible — its messages verify as coming from a stranger and
# are dropped, leaving the cluster permanently one vote short with nothing in
# any log to say why.
VALIDATOR_SET=

# Every OTHER validator's P2P URL, `name=url`. Required, and required to be
# complete: with N=4 and a quorum of 3 there is exactly one failure of slack,
# and spending it on a typo rather than on a machine that actually died is not
# a trade worth making silently.
CONSENSUS_PEERS=

# Every other validator's JSON-RPC URL, `name=url`. Optional.
#
# It lets a node forward a submitted transaction straight to the current
# proposer, which is the difference between a vote landing immediately and
# landing after a round change. Without it every validator handles its own
# submissions, which is still correct — just slower when the receiving node is
# not the proposer. Separate from CONSENSUS_PEERS because that carries the
# *P2P* URL, and inferring one from the other by port arithmetic breaks the
# first time someone deploys behind a proxy.
VALIDATOR_RPC_URLS=

# How long a round waits for its proposer before calling for a round change.
# This bounds how long one failed proposer can stall the chain. Minimum 500.
ROUND_TIMEOUT_MS=4000

# Signatures required to finalize a block. Empty derives ceil(2N/3) — 3 for
# the four-validator set. Raising it is allowed (4 of 4 is safe, it simply
# tolerates no failures); lowering it below the Byzantine threshold is
# refused, because two disjoint quorums could then finalize different blocks
# at the same height.
QUORUM=

# --- mTLS ---------------------------------------------------------------
#
# Generate a local set with `make gen-certs`. A standalone node reads none of
# these. In production all three point at the shared cluster certificate,
# which acts as its own CA.
TLS_CERT=./certs/server.crt
TLS_KEY=./certs/server.key
TLS_CA=./certs/ca.crt

# --- RPC surface --------------------------------------------------------

# Enables the evm_*, hardhat_setBalance and anvil_setBalance namespaces.
#
# NEVER true on a production node. These mutate chain state outside a
# transaction. When false the namespaces are not registered at all, so every
# method in them answers -32601 exactly as a method that was never written
# would — there is no code path on a production node that can reach them.
DEV_RPC=false

# zkchain (honest) | anvil (claim to be anvil, for tooling that special-cases
# client identity).
CLIENT_VERSION_MODE=zkchain

# Comma-separated origins, or * for any.
CORS_ORIGINS=*

# Per-IP token bucket. Loopback is exempt.
RPC_RATE_LIMIT_RPS=100
RPC_RATE_LIMIT_BURST=200

# Maximum blocks one eth_getLogs query may span. Purely DoS protection — a
# whole election's chain is orders of magnitude smaller than this.
LOG_RANGE_LIMIT=100000

# --- logging ------------------------------------------------------------

# trace|debug|info|warn|error|fatal|panic|disabled
LOG_LEVEL=info

# console (human) | json (aggregation; what production uses)
LOG_FORMAT=console
