# zk-blockchain node — v2 environment reference (MASTER §7).
# Copy to .env for local dev; godotenv loads it automatically if present.
# All vars are optional and fall back to the defaults shown below.
# Precedence is env-only — no CLI flags, no config files.

# ─── Identity ─────────────────────────────────────────────────────────────
CHAIN_ID=9494
ROLE=primary            # primary | replica

# ─── Networking ───────────────────────────────────────────────────────────
RPC_PORT=9545            # public JSON-RPC HTTP port
P2P_PORT=9546            # mTLS block-sync port (M10)
CORS_ORIGINS=*           # "*" or a comma-separated allowlist
# RPC_RATE_LIMIT_RPS/_BURST are not in the original MASTER §7 table; added
# in M04 for internal/rpc's per-IP token-bucket limiter. localhost is
# always exempt.
RPC_RATE_LIMIT_RPS=100    # steady-state requests/sec allowed per IP
RPC_RATE_LIMIT_BURST=200  # instantaneous burst capacity per IP
# LOG_RANGE_LIMIT is not in the original MASTER §7 table; added in M06 as
# DoS protection for eth_getLogs. Max blocks one query may span, both
# endpoints inclusive. An election's whole chain is far smaller, so the
# app's own fromBlock:0 scans never approach it.
LOG_RANGE_LIMIT=100000

# ─── Storage ──────────────────────────────────────────────────────────────
DATA_DIR=./data

# ─── Replica-only (required when ROLE=replica) ───────────────────────────
# PRIMARY_RPC_URL is the sequencer's *public JSON-RPC* URL: a replica serves
# every read locally and forwards eth_sendRawTransaction and the evm_/
# hardhat_/anvil_ namespaces there (M10). REPLICA_PULL_URL is the
# sequencer's *P2P* URL (mTLS), used to pull blocks this node is missing at
# boot and after any gap.
# PRIMARY_RPC_URL=http://primary-host:9545
# REPLICA_PULL_URL=https://primary-host:9546

# ─── Primary-only (optional; comma-separated replica push URLs) ─────────
# Setting PEERS is what makes this node a sequencer *with replicas*: it then
# opens the mTLS P2P port and needs the TLS material below. Leave it unset
# for a standalone node — no P2P port, no certificates required.
# PEERS=https://replica1-host:9546,https://replica2-host:9546

# ─── Execution ────────────────────────────────────────────────────────────
BLOCK_GAS_LIMIT=60000000 # must stay > 15000000 (mobile vote tx gas)
# DEV_RPC registers the evm_increaseTime / evm_setNextBlockTimestamp /
# evm_mine / hardhat_setBalance / anvil_setBalance namespaces (M07). These
# mutate chain state outside a transaction — required by the hardhat
# contract test suite and the dev faucet, and never to be enabled on a
# production node. When false the namespaces are not registered at all, so
# every method in them answers -32601.
DEV_RPC=false

# ─── Compatibility ────────────────────────────────────────────────────────
# CLIENT_VERSION_MODE is not in the original MASTER §7 table; added in M07.
# Selects what web3_clientVersion reports: "zkchain" -> "zkchain/v2.0.0"
# (the honest default), "anvil" -> "anvil/v1.0.0-zkchain". Only switch to
# anvil if some plugin is empirically found to refuse an unfamiliar client
# identity (M07 deliverable 5, verified during M08's hardhat test run).
CLIENT_VERSION_MODE=zkchain

# ─── mTLS (P2P, M10; `make gen-certs`) ────────────────────────────────────
# Only read when this node joins a cluster (PEERS set, or ROLE=replica).
# `make gen-certs` writes ca.crt/ca.key plus one pair per node name, so a
# node's own files are ./certs/<name>.crt and ./certs/<name>.key —
# e.g. TLS_CERT=./certs/primary.crt. The CA is the cluster's only
# membership credential; see README's "Certificates and rotation".
TLS_CERT=./certs/server.crt
TLS_KEY=./certs/server.key
TLS_CA=./certs/ca.crt

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info            # trace|debug|info|warn|error|fatal|panic|disabled
# LOG_FORMAT is not in the original MASTER §7 table; added in M01 (Agent
# Rule 8: new env vars must be documented here) so main.go can pick a
# human-readable console writer (dev) vs JSON (prod/replica log aggregation).
LOG_FORMAT=console        # console | json
