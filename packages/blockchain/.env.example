# zk-blockchain node — v2 environment reference (MASTER §7).
# Copy to .env for local dev; godotenv loads it automatically if present.
# All vars are optional and fall back to the defaults shown below.
# Precedence is env-only — no CLI flags, no config files.

# ─── Identity ─────────────────────────────────────────────────────────────
CHAIN_ID=9494
ROLE=primary            # primary | replica

# ─── Networking ───────────────────────────────────────────────────────────
RPC_PORT=9545            # public JSON-RPC HTTP port
P2P_PORT=9546            # mTLS block-sync port (M10)
CORS_ORIGINS=*           # "*" or a comma-separated allowlist
# RPC_RATE_LIMIT_RPS/_BURST are not in the original MASTER §7 table; added
# in M04 for internal/rpc's per-IP token-bucket limiter. localhost is
# always exempt.
RPC_RATE_LIMIT_RPS=100    # steady-state requests/sec allowed per IP
RPC_RATE_LIMIT_BURST=200  # instantaneous burst capacity per IP

# ─── Storage ──────────────────────────────────────────────────────────────
DATA_DIR=./data

# ─── Replica-only (required when ROLE=replica) ───────────────────────────
# PRIMARY_RPC_URL=https://primary-host:9545
# REPLICA_PULL_URL=https://primary-host:9546

# ─── Primary-only (optional; comma-separated replica push URLs) ─────────
# PEERS=https://replica1-host:9546,https://replica2-host:9546

# ─── Execution ────────────────────────────────────────────────────────────
BLOCK_GAS_LIMIT=60000000 # must stay > 15000000 (mobile vote tx gas)
DEV_RPC=false             # enables evm_*, hardhat_setBalance, anvil_setBalance

# ─── mTLS (P2P, M10; `make gen-certs`) ────────────────────────────────────
TLS_CERT=./certs/server.crt
TLS_KEY=./certs/server.key
TLS_CA=./certs/ca.crt

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info            # trace|debug|info|warn|error|fatal|panic|disabled
# LOG_FORMAT is not in the original MASTER §7 table; added in M01 (Agent
# Rule 8: new env vars must be documented here) so main.go can pick a
# human-readable console writer (dev) vs JSON (prod/replica log aggregation).
LOG_FORMAT=console        # console | json
