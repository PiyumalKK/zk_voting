# Template for NextJS environment variables.
#
# For local development, copy this file to .env.local and fill in the values.
# When deploying live, store the vars in Vercel/System config instead.
#
# NEXT_PUBLIC_ vars are exposed to the browser; everything else stays server-side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables

NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=


# ── Chain selection — the swap switch ────────────────────────────────────────
# The app runs against either backend with NO source changes. Set the three
# vars below to one column and restart (`yarn start`). See the root README →
# "Switching Chain Backends" and 00-MASTER.md §7/§8.
#
#   Variable                    | Hardhat mode            | Custom mode
#   ----------------------------|-------------------------|-----------------------
#   NEXT_PUBLIC_CHAIN_BACKEND   | hardhat (or unset)      | custom
#   NEXT_PUBLIC_CHAIN_ID        | 31337                   | 9494
#   NEXT_PUBLIC_RPC_URL         | http://127.0.0.1:8545   | http://127.0.0.1:9545
#
# Hardhat mode needs `yarn chain` + `yarn deploy`.
# Custom mode needs `make run` in packages/blockchain + `yarn deploy --network custom`.
NEXT_PUBLIC_CHAIN_BACKEND=hardhat
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Server-side RPC override (no NEXT_PUBLIC_). Optional — falls back to
# NEXT_PUBLIC_RPC_URL. Set it when the Next.js server reaches the node at a
# different address than the browser does: containers, or reading from a
# replica while writes go to the sequencer.
RPC_URL=

# Optional NicRegistry override. Leave EMPTY in normal use: the address is read
# per-chain from contracts/deployedContracts.ts, so it is correct in both modes.
# A single hardcoded address here cannot be — it would be wrong on one of them.
# Set it only to point at a registry deployed outside `yarn deploy`.
NEXT_PUBLIC_NIC_REGISTRY_ADDRESS=

# ── Dev faucet (SERVER-side) ─────────────────────────────────────────────────
# Chain ids /api/faucet is willing to fund on — both local chains by default.
# It signs with a well-known public test key, so it must never be enabled on a
# real network. Custom mode charges no gas, so funding is a convenience there.
FAUCET_CHAIN_IDS=31337,9494

# Hashed-NIC registry (SERVER-side only — never expose this value to the browser)
# Use a long, randomly generated secret in .env.local / deployment configuration.
SERVER_PEPPER=9b4e7a1f3c8d6e2a5f0b9c7d4e1a8f6c3b5d2e9a7f1c8b4d6e0a3f9c2b7d5e8a1f4c6d9e2b8a0f7c3d5e1a9b6c4d8f2

# ── No-wallet auth (custom mode only) — M12 ──────────────────────────────────
# Every variable below is SERVER-side and applies ONLY when
# NEXT_PUBLIC_CHAIN_BACKEND=custom. In hardhat mode the auth routes return 404,
# the middleware passes every request through, and MetaMask works as before —
# so leaving this whole block empty is correct for hardhat mode.
#
# Admin and GN officers sign in with credentials; the server relay
# (POST /api/relay) holds their keys and signs whitelisted contract calls on
# their behalf. See 01-AUTH-DESIGN.md.

# Seals the session cookie. 32+ bytes. Rotating it signs everyone out.
#   openssl rand -base64 32
SESSION_SECRET=

# The election administrator's login. The password is stored as a bcrypt hash —
# never the password itself. Generate the hash with:
#   node -e "import('bcryptjs').then(b=>b.hash(process.argv[1],12)).then(console.log)" 'your-password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# The key the relay signs admin actions with. It MUST be the account that owns
# the deployed contracts, or every onlyOwner call reverts. In development that
# is Hardhat account #0 of the default test mnemonic:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# WARNING: that key is public and belongs in development only. A production
# deployment uses a dedicated key created at deploy time, held in a secret
# manager or HSM — see 01-AUTH-DESIGN.md §6.
ADMIN_RELAY_PRIVATE_KEY=

# AES-256-GCM key encrypting GN officers' private keys at rest in
# data/gn-accounts.json. 32 bytes, hex or base64:
#   openssl rand -hex 32
# Losing it makes every existing GN account unusable (the keys cannot be
# recovered); rotating it requires re-issuing those accounts.
GN_KEY_ENCRYPTION_KEY=

# Optional overrides for where the auth data lives. Both default to ./data.
# GN_ACCOUNTS_FILE=
# RELAY_AUDIT_LOG=
