# Template for NextJS environment variables.
#
# For local development, copy this file to .env.local and fill in the values.
# When deploying live, store the vars in Vercel/System config instead.
#
# NEXT_PUBLIC_ vars are exposed to the browser; everything else stays server-side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables

NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=


# ── Chain backend selection (see README → "Switching Chain Backends") ────────
# "hardhat" (default): Ethereum via wagmi/viem — run `yarn chain` + `yarn deploy`
# "custom":            the Go blockchain node's REST API (packages/blockchain)
NEXT_PUBLIC_CHAIN_BACKEND=hardhat
# Go node public API base URL (custom backend only)
NEXT_PUBLIC_CHAIN_API_URL=http://localhost:3001
# Deployed central NicRegistry contract address (set after deployment).
NEXT_PUBLIC_NIC_REGISTRY_ADDRESS=0x9A9f2CCfdE556A7E9Ff0848998Aa4a0CFD8863AE

# ── Admin signing proxy (custom backend only, SERVER-side — no NEXT_PUBLIC_) ─
# Password the /voting/admin page must present.
ADMIN_API_PASSWORD=
# RSA private key whose public half sits at
# packages/blockchain/data_<NODE_ID>/keys/admin_public.pem
ADMIN_PRIVATE_KEY_PATH=../blockchain/data_3001/keys/admin_private.pem
# Node URL as seen from the Next.js server (defaults to NEXT_PUBLIC_CHAIN_API_URL).
CHAIN_API_URL=

# Hashed-NIC registry (SERVER-side only â€” never expose this value to the browser)
# Use a long, randomly generated secret in .env.local / deployment configuration.
SERVER_PEPPER=9b4e7a1f3c8d6e2a5f0b9c7d4e1a8f6c3b5d2e9a7f1c8b4d6e0a3f9c2b7d5e8a1f4c6d9e2b8a0f7c3d5e1a9b6c4d8f2
